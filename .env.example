# Copy to .env.local and fill in real values. Never commit .env.local.

# Google OAuth client — from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI must be exactly:
#   http://localhost:3003/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Dev server runs on port 3003 (see package.json), not NextAuth's default 3000 —
# without this, callback/redirect URLs are built against the wrong origin.
AUTH_URL=http://localhost:3003

# Shared secret used to sign the short-lived internal JWT sent to the backend
# in src/lib/backend-client.ts. Must match what the backend verifies with.
INTERNAL_JWT_SECRET=

# Backend API base URL, e.g. http://localhost:8000
BACKEND_URL=
